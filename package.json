{
  "name": "who-ruined-cs2",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.25.0",
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev --parallel",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test && vitest run tests/golden/real-demo.test.ts",
    "test:golden": "pnpm --filter @who-ruined/match-domain... build && vitest run tests/golden/real-demo.test.ts",
    "parser:probe": "pnpm --filter @who-ruined/parser-adapter probe",
    "db:generate": "prisma generate",
    "db:push": "prisma db push"
  },
  "devDependencies": {
    "@eslint/js": "9.37.0",
    "@prisma/client": "6.17.1",
    "@types/node": "22.18.8",
    "csgo-protobuf": "4.1.12",
    "eslint": "9.37.0",
    "globals": "16.4.0",
    "prisma": "6.17.1",
    "turbo": "2.5.8",
    "typescript": "5.9.3",
    "typescript-eslint": "8.46.1",
    "vitest": "3.2.4"
  }
}
